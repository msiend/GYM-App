{
  "name": "form-fitness",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e.mjs",
    "test:install": "npm run build && node tests/install.mjs",
    "test:redesign": "npm run build && node tests/redesign.mjs",
    "test:ux": "npm run build && node tests/ui-ux.mjs",
    "check": "npm test && npm run build && node tests/e2e.mjs && node tests/ui-ux.mjs && node tests/redesign.mjs && node tests/install.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "dexie": "latest",
    "dexie-react-hooks": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "fake-indexeddb": "latest",
    "playwright": "^1.64.1",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest"
  }
}
